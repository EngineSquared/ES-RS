#speed-counter-metrics > span,
#gear-metrics > span
{
    opacity: 1;
}

#speed-counter-metrics > #value,
#gear-metrics > #gear-current
{
    font-size: 48px;
    color: rgb(214,214,214);
    margin: 0;
}

#speed-counter-metrics > #title,
#gear-metrics > #transmission-mode
{
    font-size: 18px;
    color: rgb(160,160,160);
    margin: 0;
}

#speed-counter-metrics
{
    position: absolute;
    right: 5%;
    bottom: 15px;
    width: 50%;
    height: 100%;
    transform: translateX(-100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
}

#gear-metrics
{
    position: absolute;
    left: 5%;
    bottom: 15px;
    width: 50%;
    height: 100%;
    transform: translateX(100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
}
