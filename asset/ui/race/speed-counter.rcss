#speed-counter-box,
#rpm-led > div
{
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 500px;
    height: 121px;
    transform: translateX(-50%);
}

#rpm-led > div {
    opacity: 0;
    transition: opacity 0.05s linear-in-out;
}

#speed-counter-box
{
    decorator: image("../../sprites/speed-counter.tga" cover);
    opacity: 0.68;
}

#sc-01
{
    decorator: image("../../sprites/sc-01.tga" cover);
    opacity: 0;
}

