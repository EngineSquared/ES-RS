@keyframes slide-in
{
    0% {
        opacity: 0;
        transform: translateY(-130%);
    }
    to {
        opacity: 1;
        transform: translateY(0%);
    }
}

#pause-menu
{
    visibility: hidden;
    animation: none;
}

#pause-window
{
    position: absolute;
    top: 50%;
    left: 50%;
    width: 35%;
    height: 55%;
    transform: translate(-50%, -50%);
    decorator: image("../../sprites/pause-menu.png" cover);
    opacity: 0.6;
    text-align: center;
    font-family: airborne;
}

#pause-window-content
{
    position: absolute;
    top: 50%;
    left: 50%;
    width: 35%;
    height: 55%;
    transform: translate(-50%, -50%);
    decorator: image("../../sprites/pause-menu.png" cover);
    opacity: 0.6;
    text-align: center;
    font-family: airborne;
}

#pause-window > .title
{
    font-size: 62px;
    opacity: 1;
    position: absolute;
    top: 40px;
    left: 50%;
    transform: translateX(-50%);
    font-family: airborne;
}

#esrs-button
{
    opacity: 1;
}

#resume-btn
{
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 40%;
}

#quit-btn
{
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 60%;
}