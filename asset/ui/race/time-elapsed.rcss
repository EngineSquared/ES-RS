#timer
{
    position: absolute;
    top: 25px;
    left: 25px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}

#timer > #time-elapsed
{
    text-align: center;
}

#timer > #time-value
{
    font-size: 32px;
	color:rgb(214,214,214);
    font-effect: shadow(2px rgb(0, 0, 0));
    font-family: airborne;
}