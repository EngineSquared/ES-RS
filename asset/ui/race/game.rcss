@keyframes fade-out {
    0%       { background-color: transparent; }
    100%     { background-color: rgb(0, 0, 0); }
}

@keyframes slide-in-top
{
    0%      { transform: translateY(-130%); }
    100%    { transform: translateY(0%); }
}

body
{
    font-family: airborne;
}

#fade-out-mask
{
	position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: black;
    visibility: hidden;
    animation: none;
    z-index: 99;
}

#metrics
{
	position: absolute;
	bottom: 0px;
	right: 0px;
	padding: 10px;
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	gap: 10px;
    animation: 1s quartic-out 1 slide-in-top;
}

#metrics > div
{
	display: block;
}
