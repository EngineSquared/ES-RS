<rml>
	<head>
		<title>main-menu</title>
		<link type="text/rcss" href="../esrs-btn.rcss" />
		<link type="text/rcss" href="main-menu.rcss" />
	</head>
	<body>
		<div id="fade-out-mask"></div>
		<div id="background-img">
			<div class="bckg-img1"></div>
			<div class="bckg-img2"></div>
			<div class="bckg-img3"></div>
		</div>
		<div id="start-game-btn">
			<button id="esrs-button">
				<div class="idle-pattern"></div>
				<div class="active-pattern"></div>
				<div class="idle"></div>
				<div class="active"></div>
				<div class="test-wrapper">
					<h1 class="text">START</h1>
				</div>
			</button>
		</div>
		<div id="quit-game-btn">
			<button id="esrs-button">
				<div class="idle-pattern"></div>
				<div class="idle"></div>
				<div class="active-pattern"></div>
				<div class="active"></div>
				<div class="test-wrapper">
					<h1 class="text">QUIT</h1>
				</div>
			</button>
		</div>
		<div id="gradient-top"></div>
		<div id="gradient-bottom"></div>
		<div id="game-title"></div>
		<div id="flag-footer-div">
			<div id="flag-footer-image-top"></div>
			<div id="flag-footer-image-bottom"></div>
			<h2 id="footer-credits">Made with Engine Squared</h2>
		</div>
	</body>
</rml>