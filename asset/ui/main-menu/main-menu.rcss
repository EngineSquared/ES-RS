/* Global definitions */

@keyframes game-title-animator {
	0%, 10% {
		opacity: 0;
        top: 10%;
	}
	to {
		opacity: 1;
        top: 15%;
	}
}

@keyframes title-flag-animator {
	0% {
		transform: translateX(-43px)
	}
	to {
		transform: translateX(0px)
	}
}

@keyframes title-flag-in {
	0%, 10% {
		opacity: 0;
	}
	to {
		opacity: 1;
	}
}

@keyframes title-gradient-in {
	0%, 10% {
		opacity: 0;
	}
	to {
		opacity: .7;
	}
}

/* RmlUi doesn't support 'animation-delay' property, this is a workaround */
@keyframes slide1 {
    0%       { opacity: 1; }
    33.333%  { opacity: 1; }
    40%      { opacity: 0; }
    93.333%  { opacity: 0; }
    100%     { opacity: 1; }
}

@keyframes slide2 {
    0%       { opacity: 0; }
    33.333%  { opacity: 0; }
    40%      { opacity: 1; }
    66.666%  { opacity: 1; }
    73.333%  { opacity: 0; }
    100%     { opacity: 0; }
}

@keyframes slide3 {
    0%       { opacity: 0; }
    66.666%  { opacity: 0; }
    73.333%  { opacity: 1; }
    93.333%  { opacity: 1; }
    100%     { opacity: 0; }
}
/* --- */

@keyframes fade-out {
    0%       { background-color: transparent; }
    100%     { background-color: rgb(0, 0, 0); }
}

body
{
    font-family: airborne;
    background-color: rgb(0, 0, 0);
}

#fade-out-mask
{
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: black;
    visibility: hidden;
    animation: none;
    z-index: 99;
}

/* End of global definitions */

#start-game-btn {
    position: absolute;
    top: 35%;
    left: 50%;
    transform: translateX(-50%);
}

#quit-game-btn {
    position: absolute;
    top: 48%;
    left: 50%;
    transform: translateX(-50%);
}

#game-title
{
    decorator: image("../../sprites/title-logo.tga" cover);
    position: absolute;
    top: 15%;
    left: 50%;
    width: 347px;
    height: 113px;
    transform: translateX(-50%) scale(0.74);
    animation: 1s quartic-out 1 game-title-animator;
}

#flag-footer-div
{
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    z-index: 1;
    animation: 1s quartic-out 1 title-flag-in;
}

#flag-footer-image-top
{
    decorator: image("../../sprites/pattern.tga" flip-vertical repeat-x);
    position: absolute;
    top: -91px;
    left: 0;
    width: 400%;
    height: 179px;
    animation: 3s linear-inOut infinite title-flag-animator;
}

#flag-footer-image-bottom
{
    decorator: image("../../sprites/pattern.tga" repeat-x);
    position: absolute;
    bottom: -91px;
    left: 0;
    width: 400%;
    height: 179px;
    animation: 3s linear-inOut infinite title-flag-animator;
}

#footer-credits
{
    position: absolute;
    bottom: 86px;
    right: 0;
    text-align: right;
    font-size: 24px;
    margin: 10px;
}

#gradient-top
{
    decorator: image("../../sprites/gradient.tga" cover);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 130px;
    opacity: .7;
    animation: 1s quartic-out 1 title-gradient-in;
}

#gradient-bottom
{
    decorator: image("../../sprites/gradient.tga" flip-vertical cover);
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 130px;
    opacity: .7;
    animation: 1s quartic-out 1 title-gradient-in;
}

#background-img
{
    animation: 1s quartic-out 1 game-title-animator;
    width: 100%;
    height: 100%;
}

#background-img > div
{
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

#background-img > .bckg-img1
{
    decorator: image("../../sprites/background1.png" cover);
    animation: side1 15s infinite;
}

#background-img > .bckg-img2
{
    decorator: image("../../sprites/background2.png" cover);
    animation: slide2 15s infinite;
}

#background-img > .bckg-img3
{
    decorator: image("../../sprites/background3.png" cover);
    animation: slide3 15s infinite;
}